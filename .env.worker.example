NTHUSA_BOT_NAME=NTHUSA Bot
MINISAGO_BRIDGE_URL=ws://core:3000/api/worker/ws
MINISAGO_MCP_URL=http://core:3000/api/chatbot/mcp
# Use exactly the same random secret and owner ID as the core.
MINISAGO_WORKER_BRIDGE_SECRET=
MINISAGO_CHATBOT_OWNER_USER_ID=
MINISAGO_MAX_CONCURRENT_JOBS=2
MINISAGO_WORKER_ID=oracle
MINISAGO_CHATBOT_REPOSITORY=NTHU-SA/discord-bot
MINISAGO_GITHUB_CONFIG_DIR=/home/bun/.config/gh
MINISAGO_GITHUB_WORKTREE_ROOT=/workspace/worktrees
# Optional: enable only after the NTHUSA operator installs the host runner.
MINISAGO_DEPLOY_SOCKET=

# Commit identity for repository work; set an association-approved address.
NTHUSA_GIT_AUTHOR_NAME=NTHUSA Bot
NTHUSA_GIT_AUTHOR_EMAIL=discord-bot@users.noreply.github.com
