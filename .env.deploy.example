# Docker Compose interpolation only; no application credentials.
NTHUSA_IMAGE_TAG=main
NTHUSA_CORE_IMAGE=ghcr.io/nthu-sa/discord-bot
NTHUSA_WORKER_IMAGE=ghcr.io/nthu-sa/discord-bot-worker
NTHUSA_HTTP_PORT=3000
NTHUSA_SANDBOX_JOBS_ROOT=/var/lib/nthusa-sandbox
NTHUSA_DEPLOY_SOCKET_DIR=/run/nthusa-discord-bot
NTHUSA_DEPLOY_STATE_DIR=/var/lib/nthusa-discord-bot
