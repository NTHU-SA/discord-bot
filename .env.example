# Local core development. Worker configuration is separate.
# NTHUSA chooses the final display name and sets the same value on the worker.
NTHUSA_BOT_NAME=NTHUSA Bot
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_GATEWAY_DISABLED=false
MINISAGO_CHATBOT_OWNER_USER_ID=
# Configure either guilds or individual channels; IDs are comma-separated.
MINISAGO_CHATBOT_GUILD_IDS=
MINISAGO_CHATBOT_CHANNEL_IDS=
MINISAGO_CHATBOT_ROLE_IDS=
MINISAGO_AMBIENT_REACTIONS_ENABLED=false
MINISAGO_AMBIENT_ATTENTION_CHANCE=0.25
MINISAGO_AMBIENT_MAX_CHECKS_PER_HOUR=4
MINISAGO_WORKER_BRIDGE_SECRET=
MINISAGO_WORKER_ID=oracle
MINISAGO_REMINDER_STATE_FILE=.data/reminders.json
MINISAGO_GUILD_MEMORY_DIRECTORY=.data/guild-memory
MINISAGO_CALENDAR_DRAFTS_FILE=.data/calendar-drafts.json

# Optional NTHUSA Google integrations; credentials stay in the core.
# Calendar writes require a dedicated events calendar, separate from the office.
DISCORD_CALENDAR_ID=
DISCORD_CALENDAR_NAME=discord-calendar
DISCORD_CALENDAR_GUILD_ID=1514899496797212683
DISCORD_CALENDAR_ACCOUNT=nthusa@gapp.nthu.edu.tw
DISCORD_OFFICE_CALENDAR_ID=c_14bf5641071c6089c46061dda50e795027b7bd66885861a4f6d0a72a68cd3703@group.calendar.google.com
# Preferred OAuth setting; MINISAGO_GOOGLE_CALENDAR_OAUTH_JSON also works.
DISCORD_CALENDAR_OAUTH_JSON=
# Contact lookup uses the existing Drive credential and Google Sheets API.
DISCORD_CONTACTS_SPREADSHEET_ID=1e-GG1m6AqVsJAEtQ6fLd-qL8amTPvr2lOXKC_J_hJnU
DISCORD_CONTACTS_SHEET_ID=817689538
MINISAGO_GOOGLE_CALENDAR_OAUTH_JSON=
MINISAGO_GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
MINISAGO_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Set roles only after reviewing the NTHUSA role/group mapping.
MINISAGO_GOOGLE_DRIVE_ACCESS=
THREADS_SEARCH_READER_BASE_URL=https://r.jina.ai/

# Optional static feeds. See docs/configuration.md for the JSON shape.
X_POST_FEEDS_JSON=[]
X_POST_CHECK_INTERVAL_MS=300000
X_POST_STATE_DIRECTORY=.data/x-posts

# Optional PR lifecycle notifications; all destinations must be explicit.
GITHUB_WEBHOOK_SECRET=
GITHUB_PR_REPOSITORIES=
GITHUB_REVIEWERS_JSON={}
GITHUB_PR_THREAD_CHANNEL_ID=
GITHUB_PR_THREAD_STATE_FILE=.data/github-pr-threads.json
